# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Your Resend API key (https://resend.com) for sending real OTP emails to students.
# If not provided, the app will log the OTP to the console and show a convenient preview in dev mode.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address configured in Resend (e.g. "The Lantern <verify@yourdomain.com>" or "onboarding@resend.dev")
RESEND_FROM_EMAIL="The Lantern <onboarding@resend.dev>"

# VITE_GOOGLE_MAPS_API_KEY: Optional. Google Maps Platform API Key or Maps Demo Key (https://mapsplatform.google.com/maps-demo-key)
VITE_GOOGLE_MAPS_API_KEY=""

